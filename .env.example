# Copy to .env.local and fill in values.
# Your app has other required vars (Supabase, Stripe, etc.) in .env.local.

# --- Stripe (required for checkout) ---
# Get from https://dashboard.stripe.com/apikeys (Publishable key = pk_...)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...   (server-only, for webhooks and PaymentIntent)

# --- Sanity (portfolio CMS) ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
# NEXT_PUBLIC_SANITY_DATASET=production
# Optional: for seeding content via scripts (create token at https://sanity.io/manage with Editor role)
# SANITY_API_WRITE_TOKEN=your-write-token

# --- Medusa order management (optional) ---
# If set, confirmed orders are synced to Medusa for order management.
# MEDUSA_BACKEND_URL=http://localhost:9000
# MEDUSA_SYNC_API_KEY=your-secret-sync-key
