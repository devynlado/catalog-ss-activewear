# Copy to .env.local and fill in values.
# Your app has other required vars (Supabase, Stripe, etc.) in .env.local.

# --- Sanity (portfolio CMS) ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
# NEXT_PUBLIC_SANITY_DATASET=production
# For scripts and for Studio auto-login for admins (create token at https://sanity.io/manage with Editor role)
# SANITY_API_WRITE_TOKEN=your-write-token

# --- Medusa order management (optional) ---
# If set, confirmed orders are synced to Medusa for order management.
# MEDUSA_BACKEND_URL=http://localhost:9000
# MEDUSA_SYNC_API_KEY=your-secret-sync-key

# --- GA4 Analytics (admin Page Visitor Analytics) ---
# GA4 property ID (numeric, from Admin > Property Settings in GA4)
# GA4_PROPERTY_ID=123456789
# Service account JSON key (entire JSON as one line or escaped). Create in Google Cloud Console, enable Analytics Data API, grant the service account Viewer access to the GA4 property.
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Google Search Console (Studio Content Analytics: indexation + impressions/CTR/position) ---
# Property URL as registered in Search Console. Two formats:
#   URL-prefix property:  https://garmentdecor.com/   (must include trailing slash)
#   Domain property:      sc-domain:garmentdecor.com
# Setup: in Google Cloud Console enable "Search Console API". In Search Console
# (https://search.google.com/search-console/users) add the GA4 service account
# email as a User on the property (Restricted role is sufficient).
# GSC_SITE_URL=https://garmentdecor.com/

# --- AI meta-tag suggestions (Sanity Studio) ---
# Powers the "Generate" button on Meta Title / Meta Description fields in
# /studio for blogArticle and project documents. We use Anthropic's Claude
# Haiku 4.5 — the cheapest decent prose model. Cost is roughly $0.0005 per
# 3-suggestion generation. Get a key at https://console.anthropic.com/.
# Without this, the Generate button will return a 503 with a clear message.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (e.g. to a Sonnet for higher quality, or pin
# to a dated ID). Defaults to claude-haiku-4-5. Anthropic retires older
# aliases periodically — see https://docs.claude.com/en/about-claude/model-deprecations
# ANTHROPIC_META_MODEL=claude-haiku-4-5

# --- SS Activewear Auto-Ordering & Tracking ---
# Set to "false" to disable auto-ordering (kill switch). Orders stay at awaiting_purchasing for manual processing.
# SS_AUTO_ORDER_ENABLED=true
# Ship blind so SS packing slips don't show their branding/pricing. Set to "false" to disable.
# SS_SHIP_BLIND=true
# Orders use your S&S account payment terms (e.g. Net 30) unless you opt into a saved website payment profile.
# Saved profiles (card / ECHECK) force prepay and override Net terms — only enable if you intend to charge that way.
# SS_USE_PAYMENT_PROFILE=true
# SS_PAYMENT_PROFILE_ID=123456789
# SS_PAYMENT_EMAIL=your-ss-account@email.com
# When "true", S&S emails line-item rejections to emailConfirmation. Default off; errors are still logged in admin SS activity.
# SS_REJECT_LINE_ERRORS_EMAIL=true

# --- Rate limiting (Upstash Redis) ---
# Used by lib/rate-limit.ts to throttle abusive traffic on /api/admin/auth,
# /api/contact, /api/quote/submit, and the admin audit beacons. If either
# variable is unset, rate limiting is disabled and all requests pass through
# (helpful for local dev). Production MUST set both.
#
# Provision a free database at https://console.upstash.com (REST API tab) and
# paste the values below. Free tier = 10k commands/day, plenty for current
# traffic.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
#
# Emergency kill switch — set to "true" in Vercel to bypass rate limiting on
# any environment without removing the URL/TOKEN. Useful if you ever lock
# yourself out or Upstash has an outage and we need to fall back fast.
# RATE_LIMIT_DISABLED=false

# --- Cloudflare Turnstile (bot detection on public forms) ---
# Privacy-preserving CAPTCHA replacement that runs invisibly for most real
# users (occasional checkbox). Used on /api/contact and /api/quote/submit
# to stop bot spam that slips past the honeypot. Pair with the rate limiter:
# Turnstile catches smart bots, rate limiting caps the rest, honeypot drops
# the dumb ones for free.
#
# Setup at https://dash.cloudflare.com → Turnstile → Add site:
#   - Hostnames: garmentdecor.com, *.vercel.app
#   - Widget Mode: Managed (Cloudflare picks per-user; mostly invisible)
# Cloudflare gives you two values:
#   - Site Key  -> public, ships in client bundle as NEXT_PUBLIC_*
#   - Secret    -> private, server-only, NEVER expose to the client
#
# If either var is unset, Turnstile is disabled site-wide: the widget
# doesn't render and the server skips siteverify. The forms still work
# (defense-in-depth from honeypot + rate limiter remains active). This is
# fine for local dev; production should set both.
#
# If Cloudflare's siteverify API is unreachable or slow (>3s), the server
# fails OPEN and lets the request through with a logged warning. A bad day
# at Cloudflare cannot take your contact form offline.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
#
# Emergency kill switch — set to "true" in Vercel to disable verification
# without removing the keys. Same posture as RATE_LIMIT_DISABLED.
# TURNSTILE_DISABLED=false

# --- Google Ads offline conversions (admin /contacts "Mark as Qualified") ---
# Reports qualified leads back to Google Ads as offline (click-based)
# conversions via the Google DATA MANAGER API (datamanager.googleapis.com),
# and "retracts" them (restates value to 0) when a lead is later flagged as
# spam. Server-only — NEVER expose these to the client.
#
# Why Data Manager API: Google closed the legacy Google Ads API
# UploadClickConversions endpoint to new integrations in 2026
# (CUSTOMER_NOT_ALLOWLISTED_FOR_THIS_FEATURE). New integrations must use the
# Data Manager API. Docs: https://developers.google.com/data-manager/api
#
# Setup:
#   1. Google Cloud Console → enable the "Data Manager API" in the project.
#   2. Create an OAuth 2.0 Client (Web application) in the SAME Cloud project,
#      then generate a refresh token for a Google account with access to the
#      Ads account, using scope: https://www.googleapis.com/auth/datamanager
#   3. Create an "Import from clicks" (UPLOAD_CLICKS) conversion action in the
#      Ads account and copy its numeric id (or full resource name) below.
# Retraction caveat: Data Manager API has no true retraction; marking a
# qualified lead as spam restates its value to 0 (neutralizes value-based
# bidding) but the conversion *count* remains.
# If any required var is unset, the "Mark as Qualified" action returns 503 and
# spam retraction is skipped (no-op) — the rest of the app is unaffected.
# GADS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GADS_CLIENT_SECRET=GOCSPX-xxxxxxxx
# GADS_REFRESH_TOKEN=1//xxxxxxxx   # must be generated with the datamanager scope
# GADS_CUSTOMER_ID=9062484793
# Conversion action: numeric id (preferred) or full resource name both work:
# GADS_QUALIFIED_LEAD_CONVERSION_ACTION=7811406613
# Optional — only when operating the account through a manager (MCC):
# GADS_LOGIN_CUSTOMER_ID=
# Optional — per-lead conversion value + currency (defaults: 100 / USD):
# GADS_QUALIFIED_LEAD_VALUE=100
# GADS_QUALIFIED_LEAD_CURRENCY=USD
